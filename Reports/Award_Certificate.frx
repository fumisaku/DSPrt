<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Description="表彰状テンプレート（サンプル）" ReportInfo.Author="DSPrt">
  <Dictionary>
    <TableDataSource Name="Award" DataType="System.Data.DataTable" Enabled="true">
      <Column Name="recipientName" DataType="System.String"/>
      <Column Name="awardTitle"    DataType="System.String"/>
      <Column Name="compName"      DataType="System.String"/>
      <Column Name="kbnName"       DataType="System.String"/>
      <Column Name="awardDate"     DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="20" RightMargin="20" TopMargin="30" BottomMargin="20">
    <DataBand Name="Data1" Width="742" Height="600" DataSource="Award">
      <!-- 表彰状タイトル -->
      <TextObject Name="TxtTitle" Left="0" Top="0" Width="702" Height="60"
        Text="表　彰　状"
        Font="MS Gothic, 32pt, style=Bold" HorzAlign="Center" VertAlign="Center"/>
      <!-- 受賞者名 -->
      <TextObject Name="TxtRecipient" Left="0" Top="100" Width="702" Height="50"
        Text="[Award.recipientName]　殿"
        Font="MS Gothic, 20pt" HorzAlign="Center" VertAlign="Center"/>
      <!-- 本文 -->
      <TextObject Name="TxtBody" Left="40" Top="180" Width="620" Height="200"
        Text="あなたは [Award.compName]&#13;[Award.kbnName] において [Award.awardTitle] に輝き&#13;その卓越した技術と精神に敬意を表し&#13;ここに表彰します。"
        Font="MS Gothic, 14pt" HorzAlign="Center" VertAlign="Center" WordWrap="true"/>
      <!-- 授与日 -->
      <TextObject Name="TxtDate" Left="400" Top="500" Width="300" Height="30"
        Text="[Award.awardDate]"
        Font="MS Gothic, 12pt" HorzAlign="Right"/>
      <!-- 授与者 -->
      <TextObject Name="TxtGrantor" Left="300" Top="540" Width="402" Height="30"
        Text="公益社団法人 日本ダンス評議会"
        Font="MS Gothic, 12pt" HorzAlign="Right"/>
    </DataBand>
  </ReportPage>
</Report>
