<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Description="選手一覧表" ReportInfo.Author="DSPrt">
  <Dictionary>
    <TableDataSource Name="DM_Masters" DataType="System.Data.DataTable" Enabled="true">
      <Column Name="DM_No"        DataType="System.String"/>
      <Column Name="DM_LDispName" DataType="System.String"/>
      <Column Name="DM_PDispName" DataType="System.String"/>
      <Column Name="DM_Ctry"      DataType="System.String"/>
    </TableDataSource>
    <Parameter Name="CompName" DataType="System.String"/>
    <Parameter Name="CompDate" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="10" RightMargin="10" TopMargin="10" BottomMargin="10">
    <ReportTitleBand Name="ReportTitle1" Width="742" Height="56">
      <TextObject Name="Title" Left="0" Top="0" Width="742" Height="36"
        Text="選手一覧表"
        Font="MS Gothic, 16pt, style=Bold" HorzAlign="Center" VertAlign="Center"/>
      <TextObject Name="CompInfo" Left="0" Top="38" Width="742" Height="16"
        Text="[CompName]　[CompDate]"
        Font="MS Gothic, 9pt" HorzAlign="Center"/>
    </ReportTitleBand>
    <PageHeaderBand Name="PageHeader1" Width="742" Height="22">
      <TextObject Name="H1" Left="0"   Top="2" Width="60"  Height="18" Text="背番号"     Font="MS Gothic, 8pt, style=Bold" HorzAlign="Center" FillColor="LightGray" Border.Lines="All"/>
      <TextObject Name="H2" Left="60"  Top="2" Width="180" Height="18" Text="リーダー"   Font="MS Gothic, 8pt, style=Bold" HorzAlign="Center" FillColor="LightGray" Border.Lines="All"/>
      <TextObject Name="H3" Left="240" Top="2" Width="180" Height="18" Text="パートナー" Font="MS Gothic, 8pt, style=Bold" HorzAlign="Center" FillColor="LightGray" Border.Lines="All"/>
      <TextObject Name="H4" Left="420" Top="2" Width="180" Height="18" Text="所属"       Font="MS Gothic, 8pt, style=Bold" HorzAlign="Center" FillColor="LightGray" Border.Lines="All"/>
    </PageHeaderBand>
    <DataBand Name="Data1" Width="742" Height="20" DataSource="DM_Masters">
      <TextObject Name="D1" Left="0"   Top="2" Width="60"  Height="16" Text="[DM_Masters.DM_No]"        Font="MS Gothic, 8pt" HorzAlign="Center" Border.Lines="All"/>
      <TextObject Name="D2" Left="60"  Top="2" Width="180" Height="16" Text="[DM_Masters.DM_LDispName]" Font="MS Gothic, 8pt" Border.Lines="All"/>
      <TextObject Name="D3" Left="240" Top="2" Width="180" Height="16" Text="[DM_Masters.DM_PDispName]" Font="MS Gothic, 8pt" Border.Lines="All"/>
      <TextObject Name="D4" Left="420" Top="2" Width="180" Height="16" Text="[DM_Masters.DM_Ctry]"      Font="MS Gothic, 8pt" Border.Lines="All"/>
    </DataBand>
    <PageFooterBand Name="PageFooter1" Width="742" Height="20">
      <TextObject Name="PageNum" Left="600" Top="2" Width="142" Height="16"
        Text="[PageN] / [TotalPages]" Font="MS Gothic, 8pt" HorzAlign="Right"/>
    </PageFooterBand>
  </ReportPage>
</Report>
