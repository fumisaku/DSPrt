<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Description="決勝入賞者名簿（サンプル）" ReportInfo.Author="DSPrt">
  <Dictionary>
    <TableDataSource Name="総合結果" DataType="System.Data.DataTable" Enabled="true">
      <Column Name="総合順位表記"  DataType="System.String"/>
      <Column Name="背番号"        DataType="System.String"/>
      <Column Name="総合得点"      DataType="System.String"/>
    </TableDataSource>
    <TableDataSource Name="DV_Result" DataType="System.Data.DataTable" Enabled="true">
      <Column Name="区分名"        DataType="System.String"/>
      <Column Name="ラウンド名"    DataType="System.String"/>
      <Column Name="採点方式名"    DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="10" RightMargin="10" TopMargin="10" BottomMargin="10">
    <ReportTitleBand Name="ReportTitle1" Width="742" Height="60">
      <TextObject Name="Title" Left="0" Top="0" Width="742" Height="40"
        Text="決勝入賞者名簿"
        Font="MS Gothic, 18pt, style=Bold"
        HorzAlign="Center" VertAlign="Center"/>
      <TextObject Name="SubTitle" Left="0" Top="42" Width="742" Height="18"
        Text="[DV_Result.区分名]　[DV_Result.ラウンド名]　（[DV_Result.採点方式名]）"
        Font="MS Gothic, 10pt"
        HorzAlign="Center"/>
    </ReportTitleBand>
    <PageHeaderBand Name="PageHeader1" Width="742" Height="24">
      <TextObject Name="H1" Left="0"   Top="4" Width="80"  Height="18" Text="順位"     Font="MS Gothic, 9pt, style=Bold" HorzAlign="Center" FillColor="LightGray" Border.Lines="All"/>
      <TextObject Name="H2" Left="80"  Top="4" Width="100" Height="18" Text="背番号"   Font="MS Gothic, 9pt, style=Bold" HorzAlign="Center" FillColor="LightGray" Border.Lines="All"/>
      <TextObject Name="H3" Left="180" Top="4" Width="100" Height="18" Text="得点"     Font="MS Gothic, 9pt, style=Bold" HorzAlign="Center" FillColor="LightGray" Border.Lines="All"/>
    </PageHeaderBand>
    <DataBand Name="Data1" Width="742" Height="22" DataSource="総合結果">
      <TextObject Name="D1" Left="0"   Top="2" Width="80"  Height="18" Text="[総合結果.総合順位表記]" Font="MS Gothic, 9pt" HorzAlign="Center" Border.Lines="All"/>
      <TextObject Name="D2" Left="80"  Top="2" Width="100" Height="18" Text="[総合結果.背番号]"       Font="MS Gothic, 9pt" HorzAlign="Center" Border.Lines="All"/>
      <TextObject Name="D3" Left="180" Top="2" Width="100" Height="18" Text="[総合結果.総合得点]"     Font="MS Gothic, 9pt" HorzAlign="Center" Border.Lines="All"/>
    </DataBand>
    <PageFooterBand Name="PageFooter1" Width="742" Height="20">
      <TextObject Name="PageNum" Left="600" Top="2" Width="142" Height="16"
        Text="[PageN] / [TotalPages]"
        Font="MS Gothic, 8pt" HorzAlign="Right"/>
    </PageFooterBand>
  </ReportPage>
</Report>
