<Window x:Class="DSPrt.FontSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="フォント選択"
        Width="420"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="TxtFilter" Grid.Row="0" Margin="0,0,0,8" TextChanged="TxtFilter_TextChanged"/>

        <ListBox x:Name="LstFonts" Grid.Row="1" MouseDoubleClick="LstFonts_MouseDoubleClick"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="80" Margin="0,0,6,0" Click="BtnOk_Click"/>
            <Button Content="キャンセル" Width="80" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
