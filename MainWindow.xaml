<Window x:Class="DSPrt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DSPrt"
        Title="DSPrt"
        Width="1000" Height="640"
        MinWidth="720" MinHeight="480">

    <DockPanel>
        <!-- ステータスバー（下部） -->
        <StatusBar DockPanel.Dock="Bottom" Height="30" Background="#F0F0F0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator"
                             Width="12" Height="12"
                             Fill="Gray"
                             Margin="4,0,6,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtConnectionStatus"
                               Text="未接続"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtServerInfo"
                               Text=""
                               VerticalAlignment="Center"
                               Foreground="#555555"
                               Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtQueueInfo"
                               Text="キュー: 0"
                               VerticalAlignment="Center"
                               Foreground="#555555"
                               Margin="0,0,16,0"/>
                    <Button x:Name="BtnConnect"
                            Content="接続"
                            Width="72" Height="22"
                            Margin="0,0,6,0"
                            Click="BtnConnect_Click"/>
                    <Button x:Name="BtnDisconnect"
                            Content="切断"
                            Width="72" Height="22"
                            IsEnabled="False"
                            Click="BtnDisconnect_Click"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- タブコントロール -->
        <TabControl x:Name="MainTabControl" DockPanel.Dock="Top" Margin="4">

            <!-- ─── タブ1: ジョブログ ─────────────────────────────── -->
            <TabItem Header="ジョブログ">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ジョブログ DataGrid -->
                    <DataGrid x:Name="JobLogGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FAFAFA"
                              FontSize="12"
                              RowHeight="22">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="受信時刻"       Binding="{Binding ReceivedAt, StringFormat=HH:mm:ss}" Width="80"/>
                            <DataGridTextColumn Header="jobId"          Binding="{Binding JobId}"      Width="220"/>
                            <DataGridTextColumn Header="layoutId"       Binding="{Binding LayoutId}"   Width="160"/>
                            <DataGridTextColumn Header="部数"           Binding="{Binding Copies}"     Width="50"/>
                            <DataGridTextColumn Header="状態"           Binding="{Binding StatusText}" Width="80"/>
                            <DataGridTextColumn Header="完了時刻"       Binding="{Binding CompletedAt, StringFormat=HH:mm:ss}" Width="80"/>
                            <DataGridTextColumn Header="エラーメッセージ" Binding="{Binding ErrorMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 操作ボタン -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
                        <Button x:Name="BtnReprint"
                                Content="再印刷"
                                Width="90" Height="28"
                                Margin="0,0,6,0"
                                IsEnabled="False"
                                Click="BtnReprint_Click"/>
                        <Button x:Name="BtnClearJobLog"
                                Content="ログクリア"
                                Width="90" Height="28"
                                Click="BtnClearJobLog_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ─── タブ2: 帳票設定 ───────────────────────────────── -->
            <TabItem Header="帳票設定">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- デフォルトプリンター表示 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,8">
                        <TextBlock Text="デフォルトプリンター: " VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtDefaultPrinter" Text="-" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="BtnChangeDefaultPrinter"
                                Content="変更..."
                                Width="72" Height="22"
                                ToolTip="印刷設定のデフォルトプリンターを変更します"
                                Click="BtnChangeDefaultPrinter_Click"/>
                    </StackPanel>

                    <!-- レイアウト設定一覧 -->
                    <DataGrid x:Name="LayoutGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FAFAFA"
                              FontSize="12"
                              RowHeight="22"
                              SelectionChanged="LayoutGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="layoutId"     Binding="{Binding LayoutId}"     Width="160"/>
                            <DataGridTextColumn Header="frx ファイル" Binding="{Binding FrxPath}"      Width="220"/>
                            <DataGridTextColumn Header="データ種別"   Binding="{Binding DataType}"     Width="140"/>
                            <DataGridTextColumn Header="プリンター"   Binding="{Binding PrinterName}"  Width="160"/>
                            <DataGridTextColumn Header="部数"         Binding="{Binding Copies}"       Width="50"/>
                            <DataGridTextColumn Header="用紙"         Binding="{Binding PaperSize}"    Width="60"/>
                            <DataGridTextColumn Header="両面"         Binding="{Binding Duplex}"       Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 帳票設定操作ボタン -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
                        <Button x:Name="BtnChangeLayoutPrinter"
                                Content="プリンター変更..."
                                Width="130" Height="28"
                                Margin="0,0,6,0"
                                IsEnabled="False"
                                ToolTip="選択した帳票のプリンターを変更します（DSPrt.json に保存）"
                                Click="BtnChangeLayoutPrinter_Click"/>
                        <Button x:Name="BtnTestPrint"
                                Content="▶ テスト印刷"
                                Width="120" Height="28"
                                Margin="0,0,6,0"
                                IsEnabled="False"
                                ToolTip="選択した帳票をテストデータで試し印刷します（サーバー接続不要）"
                                Click="BtnTestPrint_Click"/>
                        <Button x:Name="BtnTestPreview"
                                Content="👁 プレビュー確認"
                                Width="130" Height="28"
                                Margin="0,0,12,0"
                                IsEnabled="False"
                                ToolTip="選択した帳票をプレビューとして表示します（印刷しない）"
                                Click="BtnTestPreview_Click"/>
                        <Button x:Name="BtnOpenDesigner"
                                Content="デザイナーで開く"
                                Width="130" Height="28"
                                Margin="0,0,6,0"
                                IsEnabled="False"
                                ToolTip="選択した .frx ファイルをデフォルトの関連アプリで開きます"
                                Click="BtnOpenDesigner_Click"/>
                        <Button x:Name="BtnOpenReportsFolder"
                                Content="Reportsフォルダを開く"
                                Width="160" Height="28"
                                ToolTip="帳票テンプレートフォルダをエクスプローラーで開きます"
                                Click="BtnOpenReportsFolder_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="賞状">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4,4,4,8">
                        <Button x:Name="BtnAwardLoad" Content="読込" Width="90" Height="28" Margin="0,0,6,0" Click="BtnAwardLoad_Click"/>
                        <Button x:Name="BtnAwardSave" Content="保存" Width="90" Height="28" Margin="0,0,6,0" Click="BtnAwardSave_Click"/>
                        <Button x:Name="BtnAwardSaveAs" Content="名前を付けて保存" Width="130" Height="28" Margin="0,0,6,0" Click="BtnAwardSaveAs_Click"/>
                        <Button x:Name="BtnAwardTestPrint" Content="テスト印刷" Width="100" Height="28" Click="BtnAwardTestPrint_Click"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="4,0,12,4" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="レイアウト名" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAwardLayoutName" Margin="0,4,0,8" TextChanged="AwardSetting_Changed"/>
                            <TextBlock Text="用紙サイズ" FontWeight="Bold"/>
                            <ComboBox x:Name="CmbAwardPaperSize" Margin="0,4,0,8" SelectionChanged="AwardSetting_Changed"/>
                            <TextBlock Text="用紙方向" FontWeight="Bold"/>
                            <ComboBox x:Name="CmbAwardOrientation" Margin="0,4,0,8" SelectionChanged="AwardSetting_Changed"/>
                            <TextBlock Text="メッシュ(mm)" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAwardMeshSize" Margin="0,4,0,8" TextChanged="AwardSetting_Changed"/>
                            <TextBlock Text="氏名印刷方式" FontWeight="Bold"/>
                            <ComboBox x:Name="CmbAwardNamePrintMode" Margin="0,4,0,8" SelectionChanged="AwardSetting_Changed"/>
                            <CheckBox x:Name="ChkAwardSurnameSingle" Content="同姓時は1枚のみ" Margin="0,0,0,8" Checked="AwardSetting_Changed" Unchecked="AwardSetting_Changed"/>
                            <TextBlock Text="最小フォントサイズ(pt)" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAwardMinimumFontSize" Margin="0,4,0,8" TextChanged="AwardSetting_Changed"/>
                            <TextBlock Text="準決勝表示" FontWeight="Bold"/>
                            <ComboBox x:Name="CmbAwardSemiFinalRankMode" Margin="0,4,0,8" SelectionChanged="AwardSetting_Changed"/>
                            <TextBlock Text="準決勝固定文言" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAwardSemiFinalText" Margin="0,4,0,8" TextChanged="AwardSetting_Changed"/>
                            <TextBlock Text="項目" FontWeight="Bold"/>
                            <ListBox x:Name="LstAwardItems" Height="220" Margin="0,4,0,8" SelectionChanged="LstAwardItems_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ItemType, Converter={x:Static Member=local:AwardItemTypeLabelConverter.Instance}}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <CheckBox x:Name="ChkAwardItemEnabled" Content="表示する" Margin="0,0,0,6" Checked="AwardSetting_Changed" Unchecked="AwardSetting_Changed"/>
                            <CheckBox x:Name="ChkAwardItemCentered" Content="中央配置" Margin="0,0,0,6" Checked="AwardSetting_Changed" Unchecked="AwardSetting_Changed"/>
                            <CheckBox x:Name="ChkAwardItemBold" Content="太字" Margin="0,0,0,6" Checked="AwardSetting_Changed" Unchecked="AwardSetting_Changed"/>
                            <TextBlock Text="文字揃え" FontWeight="Bold"/>
                            <ComboBox x:Name="CmbAwardTextAlign" Margin="0,4,0,8" SelectionChanged="AwardSetting_Changed"/>
                            <TextBlock Text="はみ出し制御" FontWeight="Bold"/>
                            <ComboBox x:Name="CmbAwardOverflowMode" Margin="0,4,0,8" SelectionChanged="AwardSetting_Changed"/>
                            <TextBlock Text="文言" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAwardItemText" Margin="0,4,0,8" AcceptsReturn="True" Height="72" TextChanged="AwardSetting_Changed"/>
                            <TextBlock Text="横(mm)" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAwardX" Margin="0,4,0,8" TextChanged="AwardSetting_Changed"/>
                            <TextBlock Text="縦(mm)" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAwardY" Margin="0,4,0,8" TextChanged="AwardSetting_Changed"/>
                            <TextBlock Text="横幅(mm)" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAwardWidth" Margin="0,4,0,8" TextChanged="AwardSetting_Changed"/>
                            <TextBlock Text="フォント名" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                <TextBox x:Name="TxtAwardFontFamily" Width="220" IsReadOnly="True"/>
                                <Button x:Name="BtnSelectAwardFont" Content="選択..." Width="70" Margin="6,0,0,0" Click="BtnSelectAwardFont_Click"/>
                            </StackPanel>
                            <TextBlock Text="フォントサイズ(pt)" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAwardFontSize" Margin="0,4,0,8" TextChanged="AwardSetting_Changed"/>
                            <TextBlock Text="行間(mm)" FontWeight="Bold"/>
                            <TextBox x:Name="TxtAwardLineSpacing" Margin="0,4,0,8" TextChanged="AwardSetting_Changed"/>
                            <TextBlock Text="順位文字列 (1-16)" FontWeight="Bold"/>
                            <DataGrid x:Name="AwardRankTextGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      Margin="0,4,0,8"
                                      Height="220"
                                      CellEditEnding="AwardRankTextGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="順位" Binding="{Binding Rank}" Width="60" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="表示文字列" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="#F8F8F8" Margin="4,0,4,4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ContentControl x:Name="AwardPreviewHost" Margin="12"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TxtAwardLayoutPath" Margin="4" Foreground="#555555"/>
                </Grid>
            </TabItem>

            <!-- ─── タブ3: プレビュー ────────────────────────────────── -->
            <TabItem Header="プレビュー">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ツールバー -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                        <TextBlock Text="対象ジョブ: " VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtPreviewJobId"
                                   Text="（ジョブログタブで行を選択してください）"
                                   VerticalAlignment="Center"
                                   Foreground="#555555"
                                   Width="350"
                                   Margin="0,0,8,0"/>
                        <Button x:Name="BtnPreview"
                                Content="プレビュー生成"
                                Width="120" Height="26"
                                IsEnabled="False"
                                ToolTip="選択したジョブの帳票を HTML としてプレビュー表示します"
                                Click="BtnPreview_Click"/>
                        <Button x:Name="BtnOpenHtml"
                                Content="ブラウザで開く"
                                Width="110" Height="26"
                                Margin="6,0,0,0"
                                IsEnabled="False"
                                Click="BtnOpenHtml_Click"/>
                    </StackPanel>

                    <!-- WebBrowser プレビュー領域 -->
                    <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="4,0,4,4">
                        <WebBrowser x:Name="PreviewBrowser"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── タブ4: 接続ログ ───────────────────────────────── -->
            <TabItem Header="接続ログ">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TxtLog"
                             Grid.Row="0"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#FAFAFA"
                             Margin="2"/>

                    <Button Grid.Row="1"
                            Content="ログクリア"
                            Width="90" Height="24"
                            HorizontalAlignment="Right"
                            Margin="4"
                            Click="BtnClearLog_Click"/>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
