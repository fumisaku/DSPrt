<Window x:Class="DSPrt.CompetitionSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="競技会の選択"
        Width="480" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 説明 -->
        <TextBlock Grid.Row="0"
                   Text="接続先サーバーに複数の競技会が存在します。&#x0a;印刷対象の競技会を選択してください。"
                   FontSize="13"
                   TextWrapping="Wrap"/>

        <!-- リスト -->
        <ListBox x:Name="LstCompetitions"
                 Grid.Row="2"
                 BorderBrush="#CCCCCC"
                 FontSize="13"
                 MouseDoubleClick="LstCompetitions_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CmpNo}"
                                   FontWeight="Bold"
                                   Foreground="#1565C0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CmpName}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CmpDate}"
                                   Foreground="#666666"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ボタン -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel"
                    Content="キャンセル"
                    Width="90" Height="30"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnOk"
                    Content="選択"
                    Width="90" Height="30"
                    Background="#1976D2" Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
